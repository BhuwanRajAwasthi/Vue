PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce_db
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
ESEWA_URL=https://rc.esewa.com.np/api/epay/main/v2/form
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET=replace-with-esewa-secret
ESEWA_SUCCESS_URL=http://localhost:4000/api/payments/esewa/success
ESEWA_FAILURE_URL=http://localhost:4000/api/payments/esewa/failure

# Email order confirmations. Create a Gmail app password or use another SMTP provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-project-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=NepKart <your-project-email@gmail.com>

# SMS OTP delivery through Twilio.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=your-twilio-phone-number

# Optional OAuth settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=